<style>
  .legal {
    padding-block: var(--space-xl);
  }

  .legal__box {
    max-width: 68ch;
  }

  .legal__box h1 {
    font-size: var(--step-3);
    margin-top: var(--space-xs);
  }

  .legal__updated {
    color: var(--muted);
    font-size: var(--step--1);
    margin-top: 0.5rem;
  }

  .legal__content {
    margin-top: var(--space-lg);
    display: grid;
    gap: var(--space-sm);
    color: var(--muted);
  }

  .legal__content h2 {
    font-size: var(--step-1);
    color: var(--ink);
    margin-top: var(--space-sm);
  }

  .legal__content strong {
    color: var(--ink);
  }
</style>
