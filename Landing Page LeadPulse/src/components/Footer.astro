---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div>
      <p class="footer__brand">LeadPulse</p>
      <p class="footer__tag">Captação e priorização de leads para times de vendas B2B.</p>
    </div>

    <nav class="footer__col" aria-label="Produto">
      <p class="footer__heading">Produto</p>
      <a href="#recursos">Recursos</a>
      <a href="#como-funciona">Como funciona</a>
      <a href="#precos">Preços</a>
    </nav>

    <nav class="footer__col" aria-label="Legal">
      <p class="footer__heading">Legal</p>
      <a href="/politica-de-privacidade">Política de Privacidade</a>
      <a href="/termos-de-uso">Termos de Uso</a>
    </nav>

    <nav class="footer__col" aria-label="Contato">
      <p class="footer__heading">Contato</p>
      {/* TODO: substituir pelo e-mail/telefone reais */}
      <a href="mailto:contato@leadpulse.example.com">contato@leadpulse.example.com</a>
      <a href="#demo">Agendar demonstração</a>
    </nav>
  </div>

  <div class="container footer__bottom">
    <p>© {year} LeadPulse. Todos os direitos reservados.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: var(--paper);
    padding-block: var(--space-lg) var(--space-md);
  }

  .footer__grid {
    display: grid;
    gap: var(--space-md);
  }

  .footer__brand {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
  }

  .footer__tag {
    margin-top: 0.5rem;
    max-width: 32ch;
    color: var(--muted-on-navy);
    font-size: var(--step--1);
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: var(--step--1);
  }

  .footer__col a {
    text-decoration: none;
    color: var(--pale-on-navy);
  }

  .footer__col a:hover {
    color: var(--paper);
  }

  .footer__heading {
    font-weight: 600;
    color: var(--paper);
    margin-bottom: 0.2rem;
  }

  .footer__bottom {
    margin-top: var(--space-lg);
    padding-top: var(--space-sm);
    border-top: 1px solid rgba(247, 246, 243, 0.12);
    font-size: var(--step--1);
    color: var(--muted-on-navy);
  }

  @media (min-width: 760px) {
    .footer__grid {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
    }
  }
</style>
